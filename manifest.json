{
  "manifest_version": 3,
  "name": "CyberOps Agent - AI Defense",
  "version": "2.0",
  "description": "Advanced Agentic AI for Real-time Phishing Defense & Forensics.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CyberOps Agent"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}