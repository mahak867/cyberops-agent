{
  "manifest_version": 3,
  "name": "CyberOps Agent",
  "version": "2.1",
  "description": "Real-time phishing defense and web forensics for Chrome. Scans pages for suspicious forms, misleading links, and social-engineering patterns.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CyberOps Agent"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
